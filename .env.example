# Exemplo de configuracao das APIs do projeto
# Copie este arquivo para .env e preencha somente as chaves necessarias.
# Nunca publique o arquivo .env ou suas credenciais.

# Gemini - utilizado em funcionalidades do projeto principal
GEMINI_API_KEY=

# OpenAI - utilizado pelo cliente OpenAI do Desafio 2
OPENAI_API_KEY=

# Groq - reservado para funcionalidades que utilizem esse provedor
GROQ_API_KEY=

# Hugging Face - reservado para funcionalidades que utilizem esse provedor
HF_TOKEN=
